<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GestionStock.Mobile.Pages.RolesPage"
             Title="Gestion des Rôles"
             BackgroundColor="#F5F7FA">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Bannière d'en-tête avec dégradé bleu -->
        <Border Grid.Row="0"
                Margin="16,12,16,8"
                Padding="16,12"
                StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="14" />
            </Border.StrokeShape>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#1E3A5F" Offset="0.0" />
                    <GradientStop Color="#2563EB" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="Gestion des Rôles"
                           TextColor="White"
                           FontAttributes="Bold"
                           FontSize="15" />
                    <Label Text="Gérer les permissions"
                           TextColor="#BFDBFE"
                           FontSize="12" />
                </VerticalStackLayout>
                <Label Grid.Column="1"
                       x:Name="RolesCountLabel"
                       Text="0 rôles"
                       TextColor="#BFDBFE"
                       FontAttributes="Bold"
                       FontSize="13"
                       VerticalOptions="Center" />
            </Grid>
        </Border>

        <!-- Bouton Ajouter -->
        <Button Grid.Row="1"
                Text="＋ Ajouter un rôle"
                Clicked="OnAddRoleClicked"
                BackgroundColor="#2563EB"
                TextColor="White"
                FontSize="13"
                FontAttributes="Bold"
                CornerRadius="12"
                HeightRequest="44"
                Margin="16,0,16,8" />

        <!-- Liste des rôles -->
        <RefreshView Grid.Row="2"
                     x:Name="RolesRefreshView"
                     Refreshing="OnRefreshing"
                     RefreshColor="#2563EB">
            <CollectionView x:Name="RolesCollectionView"
                            Margin="16,0,16,16">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,6,0,6"
                                Padding="16"
                                BackgroundColor="White"
                                StrokeThickness="1"
                                Stroke="#E2E8F0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">

                                <!-- Icone -->
                                <Border Grid.Column="0"
                                        HeightRequest="46"
                                        WidthRequest="46"
                                        BackgroundColor="#EFF6FF"
                                        StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="23" />
                                    </Border.StrokeShape>
                                    <Label Text="🛡️"
                                           FontSize="20"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>

                                <!-- Infos rôle -->
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                    <Label Text="{Binding Nom}"
                                           FontAttributes="Bold"
                                           FontSize="14"
                                           TextColor="#1E293B"
                                           LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding Description, TargetNullValue='Aucune description'}"
                                           FontSize="12"
                                           TextColor="#64748B"
                                           LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>

                                <!-- Actions -->
                                <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="6">
                                    <Button Text="✏️"
                                            Clicked="OnEditRoleClicked"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#EFF6FF"
                                            TextColor="#2563EB"
                                            FontSize="14"
                                            CornerRadius="8"
                                            HeightRequest="34"
                                            WidthRequest="40"
                                            Padding="0" />
                                    <Button Text="🗑️"
                                            Clicked="OnDeleteRoleClicked"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#FEF2F2"
                                            TextColor="#DC2626"
                                            FontSize="14"
                                            CornerRadius="8"
                                            HeightRequest="34"
                                            WidthRequest="40"
                                            Padding="0" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         Margin="40"
                                         Spacing="10">
                        <Label Text="🛡️" FontSize="44" HorizontalOptions="Center" />
                        <Label Text="Aucun rôle enregistré"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#1E293B"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
