<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GestionStock.Mobile.Pages.LoginPage"
             Shell.FlyoutBehavior="Disabled"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F5F7FA">

    <ScrollView>
        <Grid RowDefinitions="280,*">

            <!-- En-tête avec dégradé bleu professionnel -->
            <Grid Grid.Row="0">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1E3A5F" Offset="0.0" />
                        <GradientStop Color="#2563EB" Offset="0.6" />
                        <GradientStop Color="#1D4ED8" Offset="1.0" />
                    </LinearGradientBrush>
                </Grid.Background>

                <VerticalStackLayout VerticalOptions="Center"
                                     HorizontalOptions="Center"
                                     Spacing="12"
                                     Margin="0,30,0,0">

                    <!-- Logo container avec effet glassmorphism -->
                    <Border StrokeShape="RoundRectangle 22"
                            BackgroundColor="#ffff97"
                            Padding="14"
                            HeightRequest="84"
                            WidthRequest="84"
                            HorizontalOptions="Center"
                            StrokeThickness="1"
                            Stroke="#ffff97">
                        <Image Source="standard_profil_logo.png"
                               Aspect="AspectFit"
                               HeightRequest="50"
                               WidthRequest="50" />
                    </Border>

                    <Label Text="STANDARD PROFIL"
                           TextColor="#FFFFFF"
                           FontSize="22"
                           FontAttributes="Bold"
                           CharacterSpacing="2.5"
                           HorizontalOptions="Center" />

                    <Label Text="Gestion de Stock &amp; Inventaire"
                           TextColor="#BFDBFE"
                           FontSize="13"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>

            <!-- Carte de formulaire moderne light -->
            <Border Grid.Row="1"
                    Margin="24,-36,24,32"
                    Padding="28,28,28,24"
                    BackgroundColor="#FFFFFF"
                    StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#1E3A5F"
                            Offset="0,8"
                            Radius="24"
                            Opacity="0.10" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="20">

                    <!-- Titre -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Connexion"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="#1E293B" />
                        <Label Text="Bienvenue ! Veuillez vous identifier."
                               FontSize="13"
                               TextColor="#64748B" />
                    </VerticalStackLayout>

                    <!-- Séparateur -->
                    <BoxView HeightRequest="1"
                             BackgroundColor="#F1F5F9"
                             Margin="0,-4,0,-4" />

                    <!-- Bannière d'erreur -->
                    <Border x:Name="ErrorBanner"
                            IsVisible="False"
                            BackgroundColor="#FEF2F2"
                            Stroke="#FECACA"
                            StrokeThickness="1"
                            Padding="14,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <HorizontalStackLayout Spacing="10">
                            <Label Text="⚠️" FontSize="14" VerticalOptions="Center" />
                            <Label x:Name="ErrorMessageLabel"
                                   TextColor="#DC2626"
                                   FontSize="13"
                                   LineBreakMode="WordWrap"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Champ Email -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Adresse email"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#374151" />
                        <Border BackgroundColor="#F8FAFF"
                                Stroke="#E2E8F0"
                                StrokeThickness="1.5"
                                Padding="16,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Entry x:Name="EmailEntry"
                                   Placeholder="exemple@standardprofil.com"
                                   Keyboard="Email"
                                   TextColor="#1E293B"
                                   PlaceholderColor="#94A3B8"
                                   BackgroundColor="Transparent"
                                   HeightRequest="52" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Champ Mot de passe -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Mot de passe"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#374151" />
                        <Border BackgroundColor="#F8FAFF"
                                Stroke="#E2E8F0"
                                StrokeThickness="1.5"
                                Padding="16,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="*,Auto">
                                <Entry x:Name="PasswordEntry"
                                       Grid.Column="0"
                                       Placeholder="••••••••••••"
                                       IsPassword="True"
                                       TextColor="#1E293B"
                                       PlaceholderColor="#94A3B8"
                                       BackgroundColor="Transparent"
                                       HeightRequest="52" />
                                <Button Grid.Column="1"
                                        Text="👁️"
                                        FontSize="15"
                                        BackgroundColor="Transparent"
                                        Clicked="OnTogglePasswordClicked"
                                        WidthRequest="44"
                                        HeightRequest="52"
                                        TextColor="#64748B" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Bouton Connexion principal -->
                    <Button x:Name="LoginButton"
                            Text="Se connecter"
                            Clicked="OnLoginClicked"
                            HeightRequest="54"
                            CornerRadius="14"
                            FontSize="16"
                            FontAttributes="Bold"
                            TextColor="#FFFFFF"
                            Margin="0,6,0,0">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#2563EB" Offset="0.0" />
                                <GradientStop Color="#1D4ED8" Offset="1.0" />
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>

                    <!-- Indicateur de chargement -->
                    <ActivityIndicator x:Name="LoginLoadingIndicator"
                                       IsRunning="False"
                                       IsVisible="False"
                                       Color="#2563EB"
                                       HeightRequest="32" />

                    <!-- Footer -->
                    <Label Text="Standard Profil Group © 2026"
                           FontSize="11"
                           TextColor="#CBD5E1"
                           HorizontalOptions="Center"
                           Margin="0,8,0,0" />

                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>
