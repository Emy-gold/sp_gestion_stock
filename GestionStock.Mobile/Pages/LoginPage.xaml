<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GestionStock.Mobile.Pages.LoginPage"
             Shell.FlyoutBehavior="Disabled"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light=#F0F4F8, Dark=#0A1220}">

    <ScrollView>
        <Grid RowDefinitions="Auto,*">

            <!-- En-tête avec dégradé et branding -->
            <Grid Grid.Row="0" HeightRequest="260" BackgroundColor="#1A2B4A">
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10" Margin="0,20,0,0">
                    <Border StrokeShape="RoundRectangle 24"
                            BackgroundColor="#2E4270"
                            Padding="12"
                            HeightRequest="76"
                            WidthRequest="76"
                            HorizontalOptions="Center"
                            StrokeThickness="0">
                        <Image Source="standard_profil_logo.png"
                               Aspect="AspectFit"
                               HeightRequest="48"
                               WidthRequest="48" />
                    </Border>
                    <Label Text="STANDARD PROFIL"
                           TextColor="#F5A623"
                           FontSize="20"
                           FontAttributes="Bold"
                           CharacterSpacing="2"
                           HorizontalOptions="Center" />
                    <Label Text="Gestion de Stock &amp; Inventaire"
                           TextColor="#CBD5E1"
                           FontSize="13"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>

            <!-- Carte de formulaire moderne -->
            <Border Grid.Row="1"
                    Margin="20,-30,20,30"
                    Padding="24"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#162235}"
                    StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#000000"
                            Offset="0,6"
                            Radius="16"
                            Opacity="0.12" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="18">

                    <Label Text="Connexion"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#1A2B4A, Dark=#E8EEF8}"
                           Margin="0,0,0,4" />

                    <!-- Bannière d'erreur -->
                    <Border x:Name="ErrorBanner"
                            IsVisible="False"
                            BackgroundColor="#FEE2E2"
                            Stroke="#EF4444"
                            StrokeThickness="1"
                            Padding="12,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="⚠️" FontSize="14" VerticalOptions="Center" />
                            <Label x:Name="ErrorMessageLabel"
                                   TextColor="#B91C1C"
                                   FontSize="12"
                                   LineBreakMode="WordWrap"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Champ Email -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="EMAIL"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#6B7F96, Dark=#9AAABB}"
                               CharacterSpacing="1" />
                        <Border BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0D1A30}"
                                Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2E4270}"
                                StrokeThickness="1.5"
                                Padding="14,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Entry x:Name="EmailEntry"
                                   Placeholder="admin@standardprofil.com"
                                   Keyboard="Email"
                                   Text="admin@standardprofil.com"
                                   TextColor="{AppThemeBinding Light=#1A2B4A, Dark=#E8EEF8}"
                                   PlaceholderColor="{AppThemeBinding Light=#94A3B8, Dark=#475569}"
                                   BackgroundColor="Transparent"
                                   HeightRequest="48" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Champ Mot de passe -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="MOT DE PASSE"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#6B7F96, Dark=#9AAABB}"
                               CharacterSpacing="1" />
                        <Border BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0D1A30}"
                                Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2E4270}"
                                StrokeThickness="1.5"
                                Padding="14,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="*,Auto">
                                <Entry x:Name="PasswordEntry"
                                       Grid.Column="0"
                                       Placeholder="••••••••••••"
                                       IsPassword="True"
                                       Text="AdminPassword123!"
                                       TextColor="{AppThemeBinding Light=#1A2B4A, Dark=#E8EEF8}"
                                       PlaceholderColor="{AppThemeBinding Light=#94A3B8, Dark=#475569}"
                                       BackgroundColor="Transparent"
                                       HeightRequest="48" />
                                <Button Grid.Column="1"
                                        Text="👁️"
                                        FontSize="14"
                                        BackgroundColor="Transparent"
                                        Clicked="OnTogglePasswordClicked"
                                        WidthRequest="40"
                                        HeightRequest="48" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Raccourci Compte Admin Démo -->
                    <Button Text="🔑 Remplir Compte Admin"
                            Clicked="OnFillAdminClicked"
                            BackgroundColor="{AppThemeBinding Light=#EFF6FF, Dark=#1E293B}"
                            TextColor="#3B82F6"
                            FontSize="12"
                            FontAttributes="Bold"
                            CornerRadius="8"
                            HeightRequest="36"
                            Padding="8,0" />

                    <!-- Bouton Connexion -->
                    <Button x:Name="LoginButton"
                            Text="Se connecter"
                            Clicked="OnLoginClicked"
                            BackgroundColor="#F5A623"
                            TextColor="#1A2B4A"
                            FontSize="16"
                            FontAttributes="Bold"
                            CornerRadius="12"
                            HeightRequest="52"
                            Margin="0,6,0,0" />

                    <ActivityIndicator x:Name="LoginLoadingIndicator"
                                       IsRunning="False"
                                       IsVisible="False"
                                       Color="#F5A623"
                                       HeightRequest="30" />

                    <Label Text="Standard Profil Group © 2026"
                           FontSize="11"
                           TextColor="{AppThemeBinding Light=#94A3B8, Dark=#64748B}"
                           HorizontalOptions="Center"
                           Margin="0,10,0,0" />

                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>
