<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GestionStock.Mobile.Pages.UserFormPage"
             Title="{Binding FormTitle}"
             BackgroundColor="#F5F7FA">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- En-tête -->
            <Grid Padding="20,16">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#1E3A5F" Offset="0.0" />
                        <GradientStop Color="#2563EB" Offset="1.0" />
                    </LinearGradientBrush>
                </Grid.Background>
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0"
                           Text="Informations de l'utilisateur"
                           TextColor="#BFDBFE"
                           FontSize="14"
                           FontAttributes="Bold"
                           CharacterSpacing="1"
                           VerticalOptions="Center" />
                </Grid>
            </Grid>

            <!-- Corps du formulaire -->
            <VerticalStackLayout Padding="20" Spacing="18">

                <!-- Prénom -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="PRÉNOM *"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="#374151"
                           CharacterSpacing="1" />
                    <Border BackgroundColor="White" Padding="14,0" StrokeThickness="1.5" Stroke="#E2E8F0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                        <Entry x:Name="PrenomEntry" Placeholder="Ex: Jean" PlaceholderColor="#94A3B8" TextColor="#1E293B" BackgroundColor="Transparent" HeightRequest="48" />
                    </Border>
                </VerticalStackLayout>

                <!-- Nom -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="NOM *"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="#374151"
                           CharacterSpacing="1" />
                    <Border BackgroundColor="White" Padding="14,0" StrokeThickness="1.5" Stroke="#E2E8F0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                        <Entry x:Name="NomEntry" Placeholder="Ex: Dupont" PlaceholderColor="#94A3B8" TextColor="#1E293B" BackgroundColor="Transparent" HeightRequest="48" />
                    </Border>
                </VerticalStackLayout>

                <!-- Email -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="EMAIL *"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="#374151"
                           CharacterSpacing="1" />
                    <Border BackgroundColor="White" Padding="14,0" StrokeThickness="1.5" Stroke="#E2E8F0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                        <Entry x:Name="EmailEntry" Keyboard="Email" Placeholder="Ex: jean.dupont@email.com" PlaceholderColor="#94A3B8" TextColor="#1E293B" BackgroundColor="Transparent" HeightRequest="48" />
                    </Border>
                </VerticalStackLayout>

                <!-- Téléphone -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="TÉLÉPHONE"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="#374151"
                           CharacterSpacing="1" />
                    <Border BackgroundColor="White" Padding="14,0" StrokeThickness="1.5" Stroke="#E2E8F0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                        <Entry x:Name="TelephoneEntry" Keyboard="Telephone" Placeholder="Ex: +212 6 00 00 00 00" PlaceholderColor="#94A3B8" TextColor="#1E293B" BackgroundColor="Transparent" HeightRequest="48" />
                    </Border>
                </VerticalStackLayout>
                
                <!-- Role -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="RÔLE"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="#374151"
                           CharacterSpacing="1" />
                    <Border BackgroundColor="White" Padding="4,0" StrokeThickness="1.5" Stroke="#E2E8F0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                        <Picker x:Name="RolePicker" 
                                Title="Sélectionner un rôle" 
                                ItemDisplayBinding="{Binding Nom}"
                                TextColor="#1E293B" 
                                TitleColor="#94A3B8"
                                BackgroundColor="Transparent" 
                                HeightRequest="48" />
                    </Border>
                </VerticalStackLayout>

                <!-- Message d'erreur -->
                <Border x:Name="ErrorContainer" BackgroundColor="#FEF2F2" Padding="14,10" StrokeThickness="1" Stroke="#FECACA" IsVisible="False">
                    <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                    <Label x:Name="ErrorLabel" TextColor="#DC2626" FontSize="13" IsVisible="False" />
                </Border>

                <!-- Bouton Enregistrer -->
                <Button x:Name="SaveButton" Text="💾  Enregistrer l'utilisateur" Clicked="OnSaveClicked" TextColor="White" FontSize="15" FontAttributes="Bold" CornerRadius="12" HeightRequest="52" Margin="0,6,0,0">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#2563EB" Offset="0.0" />
                            <GradientStop Color="#1D4ED8" Offset="1.0" />
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>

                <ActivityIndicator x:Name="SavingIndicator" IsRunning="False" IsVisible="False" Color="#2563EB" HeightRequest="30" />

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
