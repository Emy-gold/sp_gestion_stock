<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GestionStock.Mobile.Pages.ArticlesPage"
             Title="Articles"
             BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#0B132B}">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Barre d'outils supérieure -->
        <Border Grid.Row="0"
                Margin="16,12,16,6"
                Padding="12,0"
                BackgroundColor="{AppThemeBinding Light=White, Dark=#162235}"
                Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2E4270}"
                StrokeThickness="1.5">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Label Grid.Column="0" Text="🔍" FontSize="14" VerticalOptions="Center" Margin="0,0,8,0" />
                <SearchBar Grid.Column="1"
                           x:Name="ArticleSearchBar"
                           Placeholder="Rechercher référence, nom, code-barres..."
                           TextChanged="OnSearchTextChanged"
                           BackgroundColor="Transparent"
                           HeightRequest="44" />
                <ActivityIndicator Grid.Column="2"
                                   x:Name="LoadingIndicator"
                                   IsRunning="False"
                                   IsVisible="False"
                                   Color="#F5A623"
                                   HeightRequest="20"
                                   WidthRequest="20"
                                   VerticalOptions="Center" />
            </Grid>
        </Border>

        <!-- Filtres Catégories Horizontaux -->
        <ScrollView Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalScrollBarVisibility="Never"
                    Margin="16,4,16,8">
            <HorizontalStackLayout x:Name="CategoryChipsContainer" Spacing="8">
                <!-- Rempli dynamiquement en C# -->
            </HorizontalStackLayout>
        </ScrollView>

        <!-- Liste des articles -->
        <RefreshView Grid.Row="2"
                     x:Name="RefreshViewControl"
                     Refreshing="OnRefreshing"
                     RefreshColor="#F5A623">
            <CollectionView x:Name="ArticlesCollectionView"
                            Margin="16,0,16,16">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,6,0,6"
                                Padding="0"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2E4270}"
                                BackgroundColor="{AppThemeBinding Light=White, Dark=#162235}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="#000000"
                                        Offset="0,2"
                                        Radius="8"
                                        Opacity="0.06" />
                            </Border.Shadow>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnArticleTapped" />
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="Auto,*,Auto" Padding="12" ColumnSpacing="12">

                                <!-- Vignette / Image de l'article -->
                                <Border Grid.Column="0"
                                        HeightRequest="60"
                                        WidthRequest="60"
                                        BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0D1A30}"
                                        StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>
                                    <Grid>
                                        <Label Text="📦"
                                               FontSize="24"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                        <Image Source="{Binding Image}"
                                               Aspect="AspectFill"
                                               IsVisible="{Binding Image, Converter={x:Null}}" />
                                    </Grid>
                                </Border>

                                <!-- Informations Article -->
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                    <Label Text="{Binding Designation}"
                                           FontAttributes="Bold"
                                           FontSize="15"
                                           TextColor="{AppThemeBinding Light=#1A2B4A, Dark=#E8EEF8}"
                                           LineBreakMode="TailTruncation" />

                                    <HorizontalStackLayout Spacing="8">
                                        <Label Text="{Binding Reference, StringFormat='Réf: {0}'}"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light=#3B82F6, Dark=#60A5FA}" />
                                        <Label Text="•" TextColor="#94A3B8" FontSize="10" VerticalOptions="Center" />
                                        <Label Text="{Binding CategoryArticleNom}"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                                    </HorizontalStackLayout>

                                    <Label Text="{Binding CodeBarre, StringFormat='🏷️ {0}'}"
                                           FontSize="11"
                                           TextColor="{AppThemeBinding Light=#94A3B8, Dark=#64748B}"
                                           IsVisible="{Binding CodeBarre, Converter={x:Null}}" />
                                </VerticalStackLayout>

                                <!-- Badge Stock -->
                                <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" HorizontalOptions="End" Spacing="4">
                                    <Border BackgroundColor="#EFF6FF"
                                            Padding="8,4"
                                            StrokeThickness="0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8" />
                                        </Border.StrokeShape>
                                        <Label Text="{Binding StockActuel, StringFormat='{0} u.'}"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="#1A2B4A" />
                                    </Border>
                                    <Label Text="Détails →"
                                           FontSize="11"
                                           TextColor="#94A3B8"
                                           HorizontalOptions="End" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         Margin="40"
                                         Spacing="12">
                        <Label Text="📦" FontSize="48" HorizontalOptions="Center" />
                        <Label Text="Aucun article trouvé"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#1A2B4A, Dark=#E8EEF8}"
                               HorizontalOptions="Center" />
                        <Label Text="Appuyez sur « ＋ » pour créer un nouvel article."
                               FontSize="13"
                               TextColor="{AppThemeBinding Light=#6B7F96, Dark=#9AAABB}"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>

        <!-- Bouton flottant d'ajout (+) -->
        <Button Grid.Row="2"
                Text="＋"
                Clicked="OnAddClicked"
                BackgroundColor="#F5A623"
                TextColor="#1A2B4A"
                FontSize="24"
                FontAttributes="Bold"
                CornerRadius="28"
                HeightRequest="56"
                WidthRequest="56"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="0,0,24,24">
            <Button.Shadow>
                <Shadow Brush="#000000" Offset="0,4" Radius="8" Opacity="0.25" />
            </Button.Shadow>
        </Button>

    </Grid>
</ContentPage>