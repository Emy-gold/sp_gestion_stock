<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GestionStock.Mobile.Pages.OperationsPage"
             Title="Mouvements de Stock"
             BackgroundColor="#F5F7FA">

    <Grid RowDefinitions="Auto,*">

        <!-- Bannière d'en-tête avec dégradé bleu -->
        <Border Grid.Row="0"
                Margin="16,12,16,8"
                Padding="16,12"
                StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="14" />
            </Border.StrokeShape>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#1E3A5F" Offset="0.0" />
                    <GradientStop Color="#2563EB" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="Historique des Opérations"
                           TextColor="White"
                           FontAttributes="Bold"
                           FontSize="15" />
                    <Label Text="Entrées, Sorties et Ajustements"
                           TextColor="#BFDBFE"
                           FontSize="12" />
                </VerticalStackLayout>
                <Label Grid.Column="1"
                       x:Name="OperationsCountLabel"
                       Text="0 opérations"
                       TextColor="#BFDBFE"
                       FontAttributes="Bold"
                       FontSize="13"
                       VerticalOptions="Center" />
            </Grid>
        </Border>

        <!-- Liste des opérations -->
        <RefreshView Grid.Row="1"
                     x:Name="OperationsRefreshView"
                     Refreshing="OnRefreshing"
                     RefreshColor="#2563EB">
            <CollectionView x:Name="OperationsCollectionView"
                            Margin="16,0,16,16">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,6,0,6"
                                Padding="16"
                                BackgroundColor="White"
                                StrokeThickness="1"
                                Stroke="#E2E8F0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <Border Grid.Column="0"
                                            HeightRequest="36"
                                            WidthRequest="36"
                                            BackgroundColor="#EFF6FF"
                                            StrokeThickness="0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8" />
                                        </Border.StrokeShape>
                                        <Label Text="🔄" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                        <Label Text="{Binding Numero}"
                                               FontAttributes="Bold"
                                               FontSize="14"
                                               TextColor="#1E293B" />
                                        <Label Text="{Binding CategoryOperationNom}"
                                               FontSize="12"
                                               TextColor="#2563EB"
                                               FontAttributes="Bold" />
                                    </VerticalStackLayout>

                                    <Label Grid.Column="2"
                                           Text="{Binding DateOperation, StringFormat='{0:dd/MM/yyyy}'}"
                                           FontSize="12"
                                           TextColor="#64748B"
                                           VerticalOptions="Center" />
                                </Grid>

                                <BoxView HeightRequest="1" Color="#F1F5F9" />

                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0"
                                           Text="{Binding Observation, TargetNullValue='Sans observation'}"
                                           FontSize="12"
                                           TextColor="#64748B"
                                           LineBreakMode="TailTruncation" />
                                    <Label Grid.Column="1"
                                           Text="{Binding FournisseurNom, TargetNullValue='Interne'}"
                                           FontSize="11"
                                           TextColor="#64748B"
                                           FontAttributes="Bold" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         Margin="40"
                                         Spacing="10">
                        <Label Text="🔄" FontSize="44" HorizontalOptions="Center" />
                        <Label Text="Aucun mouvement enregistré"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#1E293B"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
