<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GestionStock.Mobile.Pages.OperationsPage"
             Title="Mouvements de Stock"
             BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#0B132B}">

    <Grid RowDefinitions="Auto,*">

        <!-- Barre de titre / stats rapides -->
        <Border Grid.Row="0"
                Margin="16,12,16,8"
                Padding="16,12"
                BackgroundColor="#1A2B4A"
                StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="14" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="Historique des Opérations"
                           TextColor="White"
                           FontAttributes="Bold"
                           FontSize="15" />
                    <Label Text="Entrées, Sorties et Ajustements"
                           TextColor="#CBD5E1"
                           FontSize="12" />
                </VerticalStackLayout>
                <Label Grid.Column="1"
                       x:Name="OperationsCountLabel"
                       Text="0 opérations"
                       TextColor="#F5A623"
                       FontAttributes="Bold"
                       FontSize="13"
                       VerticalOptions="Center" />
            </Grid>
        </Border>

        <!-- Liste des opérations -->
        <RefreshView Grid.Row="1"
                     x:Name="OperationsRefreshView"
                     Refreshing="OnRefreshing"
                     RefreshColor="#F5A623">
            <CollectionView x:Name="OperationsCollectionView"
                            Margin="16,0,16,16">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,6,0,6"
                                Padding="16"
                                BackgroundColor="{AppThemeBinding Light=White, Dark=#162235}"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2E4270}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <Border Grid.Column="0"
                                            HeightRequest="36"
                                            WidthRequest="36"
                                            BackgroundColor="#EFF6FF"
                                            StrokeThickness="0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8" />
                                        </Border.StrokeShape>
                                        <Label Text="🔄" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                        <Label Text="{Binding Numero}"
                                               FontAttributes="Bold"
                                               FontSize="14"
                                               TextColor="{AppThemeBinding Light=#1A2B4A, Dark=#E8EEF8}" />
                                        <Label Text="{Binding CategoryOperationNom}"
                                               FontSize="12"
                                               TextColor="#3B82F6"
                                               FontAttributes="Bold" />
                                    </VerticalStackLayout>

                                    <Label Grid.Column="2"
                                           Text="{Binding DateOperation, StringFormat='{0:dd/MM/yyyy}'}"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}"
                                           VerticalOptions="Center" />
                                </Grid>

                                <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#F1F5F9, Dark=#1E293B}" />

                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0"
                                           Text="{Binding Observation, TargetNullValue='Sans observation'}"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}"
                                           LineBreakMode="TailTruncation" />
                                    <Label Grid.Column="1"
                                           Text="{Binding FournisseurNom, TargetNullValue='Interne'}"
                                           FontSize="11"
                                           TextColor="#F5A623"
                                           FontAttributes="Bold" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         Margin="40"
                                         Spacing="10">
                        <Label Text="🔄" FontSize="44" HorizontalOptions="Center" />
                        <Label Text="Aucun mouvement enregistré"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#1A2B4A, Dark=#E8EEF8}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
