<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GestionStock.Mobile.Pages.DashboardPage"
             Title="Tableau de bord"
             BackgroundColor="#F5F7FA">

    <RefreshView x:Name="DashboardRefreshView" Refreshing="OnRefreshing" RefreshColor="#2563EB">
        <ScrollView>
            <VerticalStackLayout Spacing="20" Padding="16">

                <!-- Bannière d'accueil avec dégradé bleu -->
                <Border Padding="20"
                        StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18" />
                    </Border.StrokeShape>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1E3A5F" Offset="0.0" />
                            <GradientStop Color="#2563EB" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="Bienvenue 👋"
                                   TextColor="#BFDBFE"
                                   FontSize="13" />
                            <Label x:Name="UserNameLabel"
                                   Text="Administrateur"
                                   TextColor="#FFFFFF"
                                   FontSize="20"
                                   FontAttributes="Bold" />
                            <Label Text="Standard Profil — Gestion de Stock"
                                   TextColor="#FEF08A"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   Margin="0,4,0,0" />
                        </VerticalStackLayout>

                        <Border Grid.Column="1"
                                StrokeShape="RoundRectangle 16"
                                BackgroundColor="#FFFFFF20"
                                Padding="8"
                                HeightRequest="56"
                                WidthRequest="56"
                                VerticalOptions="Center"
                                StrokeThickness="0">
                            <Image Source="standard_profil_logo.png" Aspect="AspectFit" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Titre Section KPI -->
                <Label Text="STATISTIQUES GÉNÉRALES"
                       FontSize="11"
                       FontAttributes="Bold"
                       TextColor="#64748B"
                       CharacterSpacing="1"
                       Margin="4,0,0,-8" />

                <!-- Grille des indicateurs KPI -->
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">

                    <!-- Total Articles -->
                    <Border Grid.Row="0" Grid.Column="0"
                            Padding="16"
                            BackgroundColor="White"
                            StrokeThickness="1"
                            Stroke="#E2E8F0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="6">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="📦" FontSize="20" />
                                <Label Text="Articles"
                                       FontSize="12"
                                       TextColor="#64748B"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Label x:Name="TotalArticlesLabel"
                                   Text="0"
                                   FontSize="26"
                                   FontAttributes="Bold"
                                   TextColor="#1E293B" />
                            <Label Text="références actives"
                                   FontSize="11"
                                   TextColor="#94A3B8" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Opérations -->
                    <Border Grid.Row="0" Grid.Column="1"
                            Padding="16"
                            BackgroundColor="White"
                            StrokeThickness="1"
                            Stroke="#E2E8F0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="6">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="🔄" FontSize="20" />
                                <Label Text="Opérations"
                                       FontSize="12"
                                       TextColor="#64748B"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Label x:Name="TotalOperationsLabel"
                                   Text="0"
                                   FontSize="26"
                                   FontAttributes="Bold"
                                   TextColor="#2563EB" />
                            <Label Text="mouvements de stock"
                                   FontSize="11"
                                   TextColor="#94A3B8" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Catégories -->
                    <Border Grid.Row="1" Grid.Column="0"
                            Padding="16"
                            BackgroundColor="White"
                            StrokeThickness="1"
                            Stroke="#E2E8F0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="6">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="🏷️" FontSize="20" />
                                <Label Text="Catégories"
                                       FontSize="12"
                                       TextColor="#64748B"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Label x:Name="TotalCategoriesLabel"
                                   Text="0"
                                   FontSize="26"
                                   FontAttributes="Bold"
                                   TextColor="#1E293B" />
                            <Label Text="familles de stock"
                                   FontSize="11"
                                   TextColor="#94A3B8" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Fournisseurs -->
                    <Border Grid.Row="1" Grid.Column="1"
                            Padding="16"
                            BackgroundColor="White"
                            StrokeThickness="1"
                            Stroke="#E2E8F0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="6">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="🏢" FontSize="20" />
                                <Label Text="Fournisseurs"
                                       FontSize="12"
                                       TextColor="#64748B"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Label x:Name="TotalFournisseursLabel"
                                   Text="0"
                                   FontSize="26"
                                   FontAttributes="Bold"
                                   TextColor="#1E293B" />
                            <Label Text="partenaires enregistrés"
                                   FontSize="11"
                                   TextColor="#94A3B8" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Actions Rapides -->
                <Label Text="ACCÈS RAPIDE"
                       FontSize="11"
                       FontAttributes="Bold"
                       TextColor="#64748B"
                       CharacterSpacing="1"
                       Margin="4,6,0,-8" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Button Grid.Column="0"
                            Text="＋ Nouvel Article"
                            Clicked="OnAddArticleClicked"
                            BackgroundColor="#2563EB"
                            TextColor="White"
                            FontSize="13"
                            FontAttributes="Bold"
                            CornerRadius="12"
                            HeightRequest="48" />

                    <Button Grid.Column="1"
                            Text="📋 Liste Articles"
                            Clicked="OnViewArticlesClicked"
                            BackgroundColor="#F1F5F9"
                            TextColor="#1E293B"
                            FontSize="13"
                            FontAttributes="Bold"
                            CornerRadius="12"
                            HeightRequest="48" />
                </Grid>

                <!-- Derniers Articles Ajoutés -->
                <Grid ColumnDefinitions="*,Auto" Margin="4,8,4,-8">
                    <Label Grid.Column="0"
                           Text="DERNIERS ARTICLES"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="#64748B"
                           CharacterSpacing="1" />
                    <Button Grid.Column="1"
                            Text="Voir tout →"
                            Clicked="OnViewArticlesClicked"
                            FontSize="11"
                            TextColor="#2563EB"
                            BackgroundColor="Transparent"
                            Padding="0"
                            HeightRequest="24" />
                </Grid>

                <CollectionView x:Name="RecentArticlesCollectionView" HeightRequest="220">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,4,0,4"
                                    Padding="12"
                                    BackgroundColor="White"
                                    StrokeThickness="1"
                                    Stroke="#E2E8F0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border Grid.Column="0"
                                            HeightRequest="40"
                                            WidthRequest="40"
                                            BackgroundColor="#EFF6FF"
                                            StrokeThickness="0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8" />
                                        </Border.StrokeShape>
                                        <Grid>
                                            <Label Text="📦" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                                            <Image Source="{Binding Image}" Aspect="AspectFill" />
                                        </Grid>
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                        <Label Text="{Binding Designation}"
                                               FontAttributes="Bold"
                                               FontSize="14"
                                               TextColor="#1E293B"
                                               LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding Reference}"
                                               FontSize="12"
                                               TextColor="#64748B" />
                                    </VerticalStackLayout>

                                    <Border Grid.Column="2"
                                            BackgroundColor="#EFF6FF"
                                            Padding="8,4"
                                            StrokeThickness="0"
                                            VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8" />
                                        </Border.StrokeShape>
                                        <Label Text="{Binding StockActuel, StringFormat='Stock: {0}'}"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="#1E3A5F" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Dernières Opérations -->
                <Grid ColumnDefinitions="*,Auto" Margin="4,8,4,-8">
                    <Label Grid.Column="0"
                           Text="DERNIÈRES OPÉRATIONS"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="#64748B"
                           CharacterSpacing="1" />
                    <Button Grid.Column="1"
                            Text="Voir tout →"
                            Clicked="OnViewOperationsClicked"
                            FontSize="11"
                            TextColor="#2563EB"
                            BackgroundColor="Transparent"
                            Padding="0"
                            HeightRequest="24" />
                </Grid>

                <CollectionView x:Name="RecentOperationsCollectionView" HeightRequest="200">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,4,0,4"
                                    Padding="12"
                                    BackgroundColor="White"
                                    StrokeThickness="1"
                                    Stroke="#E2E8F0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border Grid.Column="0"
                                            HeightRequest="40"
                                            WidthRequest="40"
                                            BackgroundColor="#EFF6FF"
                                            StrokeThickness="0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8" />
                                        </Border.StrokeShape>
                                        <Label Text="🔄" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                        <Label Text="{Binding Numero}"
                                               FontAttributes="Bold"
                                               FontSize="14"
                                               TextColor="#1E293B"
                                               LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding CategoryOperationNom}"
                                               FontSize="12"
                                               TextColor="#2563EB"
                                               FontAttributes="Bold" />
                                    </VerticalStackLayout>

                                    <Label Grid.Column="2"
                                           Text="{Binding DateOperation, StringFormat='{0:dd/MM}'}"
                                           FontSize="12"
                                           TextColor="#64748B"
                                           VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.EmptyView>
                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Margin="20" Spacing="6">
                            <Label Text="🔄" FontSize="32" HorizontalOptions="Center" />
                            <Label Text="Aucune opération récente"
                                   FontSize="13"
                                   TextColor="#94A3B8"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
