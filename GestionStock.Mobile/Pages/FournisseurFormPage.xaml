<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GestionStock.Mobile.Pages.FournisseurFormPage"
             Title="{Binding FormTitle}"
             BackgroundColor="#F5F7FA">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- En-tête avec dégradé bleu -->
            <Grid Padding="20,16">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#1E3A5F" Offset="0.0" />
                        <GradientStop Color="#2563EB" Offset="1.0" />
                    </LinearGradientBrush>
                </Grid.Background>
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0"
                           Text="Informations du fournisseur"
                           TextColor="#BFDBFE"
                           FontSize="14"
                           FontAttributes="Bold"
                           CharacterSpacing="1"
                           VerticalOptions="Center" />
                    <Button Grid.Column="1"
                            x:Name="DeleteButton"
                            Text="🗑️ Supprimer"
                            Clicked="OnDeleteClicked"
                            BackgroundColor="#EF4444"
                            TextColor="White"
                            FontSize="11"
                            FontAttributes="Bold"
                            CornerRadius="8"
                            HeightRequest="32"
                            Padding="10,0"
                            IsVisible="False" />
                </Grid>
            </Grid>

            <!-- Corps du formulaire -->
            <VerticalStackLayout Padding="20" Spacing="18">

                <!-- Nom -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="NOM DU FOURNISSEUR *"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="#374151"
                           CharacterSpacing="1" />
                    <Border BackgroundColor="White"
                            Padding="14,0"
                            StrokeThickness="1.5"
                            Stroke="#E2E8F0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Entry x:Name="NomEntry"
                               Placeholder="Ex: Acme Corporation, Supplier SA"
                               PlaceholderColor="#94A3B8"
                               TextColor="#1E293B"
                               BackgroundColor="Transparent"
                               HeightRequest="48" />
                    </Border>
                </VerticalStackLayout>

                <!-- Téléphone -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="TÉLÉPHONE"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="#374151"
                           CharacterSpacing="1" />
                    <Border BackgroundColor="White"
                            Padding="14,0"
                            StrokeThickness="1.5"
                            Stroke="#E2E8F0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Entry x:Name="TelephoneEntry"
                               Placeholder="Ex: +212 600 000 000"
                               PlaceholderColor="#94A3B8"
                               TextColor="#1E293B"
                               Keyboard="Telephone"
                               BackgroundColor="Transparent"
                               HeightRequest="48" />
                    </Border>
                </VerticalStackLayout>

                <!-- Email -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="EMAIL"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="#374151"
                           CharacterSpacing="1" />
                    <Border BackgroundColor="White"
                            Padding="14,0"
                            StrokeThickness="1.5"
                            Stroke="#E2E8F0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Entry x:Name="EmailEntry"
                               Placeholder="Ex: contact@fournisseur.com"
                               PlaceholderColor="#94A3B8"
                               TextColor="#1E293B"
                               Keyboard="Email"
                               BackgroundColor="Transparent"
                               HeightRequest="48" />
                    </Border>
                </VerticalStackLayout>

                <!-- Adresse -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="ADRESSE"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="#374151"
                           CharacterSpacing="1" />
                    <Border BackgroundColor="White"
                            Padding="14,8"
                            StrokeThickness="1.5"
                            Stroke="#E2E8F0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Editor x:Name="AdresseEditor"
                                HeightRequest="80"
                                Placeholder="Adresse complète (optionnelle)"
                                PlaceholderColor="#94A3B8"
                                TextColor="#1E293B"
                                BackgroundColor="Transparent" />
                    </Border>
                </VerticalStackLayout>

                <!-- Statut Actif (Seulement en édition) -->
                <HorizontalStackLayout x:Name="ActifContainer" Spacing="12" VerticalOptions="Center" IsVisible="False">
                    <CheckBox x:Name="ActifCheckBox" IsChecked="True" Color="#2563EB" />
                    <Label Text="Fournisseur actif" VerticalOptions="Center" TextColor="#1E293B" FontSize="14" />
                </HorizontalStackLayout>

                <!-- Message d'erreur -->
                <Border x:Name="ErrorContainer"
                        BackgroundColor="#FEF2F2"
                        Padding="14,10"
                        StrokeThickness="1"
                        Stroke="#FECACA"
                        IsVisible="False">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <Label x:Name="ErrorLabel"
                           TextColor="#DC2626"
                           FontSize="13"
                           IsVisible="False" />
                </Border>

                <!-- Bouton Enregistrer -->
                <Button x:Name="SaveButton"
                        Text="💾  Enregistrer le fournisseur"
                        Clicked="OnSaveClicked"
                        TextColor="White"
                        FontSize="15"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        HeightRequest="52"
                        Margin="0,6,0,0">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#2563EB" Offset="0.0" />
                            <GradientStop Color="#1D4ED8" Offset="1.0" />
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>

                <ActivityIndicator x:Name="SavingIndicator"
                                   IsRunning="False"
                                   IsVisible="False"
                                   Color="#2563EB"
                                   HeightRequest="30" />

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
