<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GestionStock.Mobile.Pages.CategoryOperationFormPage"
             Title="{Binding FormTitle}"
             BackgroundColor="#F5F7FA">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- En-tête avec dégradé bleu -->
            <Grid Padding="20,16">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#1E3A5F" Offset="0.0" />
                        <GradientStop Color="#2563EB" Offset="1.0" />
                    </LinearGradientBrush>
                </Grid.Background>
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0"
                           Text="Informations de la catégorie d'opération"
                           TextColor="#BFDBFE"
                           FontSize="14"
                           FontAttributes="Bold"
                           CharacterSpacing="1"
                           VerticalOptions="Center" />
                    <Button Grid.Column="1"
                             x:Name="DeleteButton"
                             Text="🗑️ Supprimer"
                             Clicked="OnDeleteClicked"
                             BackgroundColor="#EF4444"
                             TextColor="White"
                             FontSize="11"
                             FontAttributes="Bold"
                             CornerRadius="8"
                             HeightRequest="32"
                             Padding="10,0"
                             IsVisible="False" />
                </Grid>
            </Grid>

            <!-- Corps du formulaire -->
            <VerticalStackLayout Padding="20" Spacing="18">

                <!-- Nom -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="NOM DE LA CATÉGORIE D'OPÉRATION *"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="#374151"
                           CharacterSpacing="1" />
                    <Border BackgroundColor="White"
                            Padding="14,0"
                            StrokeThickness="1.5"
                            Stroke="#E2E8F0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Entry x:Name="NomEntry"
                               Placeholder="Ex: Réception marchandise, Sortie rebut"
                               PlaceholderColor="#94A3B8"
                               TextColor="#1E293B"
                               BackgroundColor="Transparent"
                               HeightRequest="48" />
                    </Border>
                </VerticalStackLayout>

                <!-- Description -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="DESCRIPTION"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="#374151"
                           CharacterSpacing="1" />
                    <Border BackgroundColor="White"
                            Padding="14,8"
                            StrokeThickness="1.5"
                            Stroke="#E2E8F0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Editor x:Name="DescriptionEditor"
                                HeightRequest="80"
                                Placeholder="Description (optionnelle)"
                                PlaceholderColor="#94A3B8"
                                TextColor="#1E293B"
                                BackgroundColor="Transparent" />
                    </Border>
                </VerticalStackLayout>

                <!-- ATTRIBUTS PERSONNALISÉS -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="ATTRIBUTS PERSONNALISÉS (Optionnel)"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="#374151"
                           CharacterSpacing="1" />
                    <Border BackgroundColor="White"
                            Padding="16"
                            StrokeThickness="1.5"
                            Stroke="#E2E8F0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="12">
                            <!-- Input pour ajouter un nouvel attribut -->
                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                <Border BackgroundColor="#F8FAFC"
                                        Padding="14,0"
                                        StrokeThickness="1"
                                        Stroke="#E2E8F0"
                                        Grid.Column="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>
                                    <Entry x:Name="NewAttributeEntry"
                                           Placeholder="Ex: Projet, Numéro BL, Immatriculation"
                                           PlaceholderColor="#94A3B8"
                                           TextColor="#1E293B"
                                           HeightRequest="44"
                                           BackgroundColor="Transparent" />
                                </Border>
                                <Button Grid.Column="1"
                                        Text="Ajouter"
                                        Clicked="OnAddAttributeClicked"
                                        BackgroundColor="#2563EB"
                                        TextColor="White"
                                        HeightRequest="44"
                                        CornerRadius="8"
                                        FontAttributes="Bold" />
                            </Grid>

                            <!-- Liste des attributs configurés -->
                            <VerticalStackLayout x:Name="AttributesStack" 
                                                 BindableLayout.ItemsSource="{Binding AttributeNames}"
                                                 Spacing="6"
                                                 Margin="0,4,0,0">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Border Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="#F8FAFC" Padding="12,6">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="6" />
                                            </Border.StrokeShape>
                                            <Grid ColumnDefinitions="*, Auto">
                                                <Label Text="{Binding .}" VerticalOptions="Center" TextColor="#1E293B" FontAttributes="Bold" />
                                                <Button Grid.Column="1"
                                                        Text="✕"
                                                        Clicked="OnRemoveAttributeClicked"
                                                        CommandParameter="{Binding .}"
                                                        BackgroundColor="Transparent"
                                                        TextColor="#EF4444"
                                                        FontAttributes="Bold"
                                                        WidthRequest="32"
                                                        HeightRequest="32"
                                                        Padding="0" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Message d'erreur -->
                <Border x:Name="ErrorContainer"
                        BackgroundColor="#FEF2F2"
                        Padding="14,10"
                        StrokeThickness="1"
                        Stroke="#FECACA"
                        IsVisible="False">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <Label x:Name="ErrorLabel"
                           TextColor="#DC2626"
                           FontSize="13"
                           IsVisible="False" />
                </Border>

                <!-- Bouton Enregistrer -->
                <Button x:Name="SaveButton"
                        Text="💾  Enregistrer la catégorie"
                        Clicked="OnSaveClicked"
                        TextColor="White"
                        FontSize="15"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        HeightRequest="52"
                        Margin="0,6,0,0">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#2563EB" Offset="0.0" />
                            <GradientStop Color="#1D4ED8" Offset="1.0" />
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>

                <ActivityIndicator x:Name="SavingIndicator"
                                   IsRunning="False"
                                   IsVisible="False"
                                   Color="#2563EB"
                                   HeightRequest="30" />

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
