<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GestionStock.Mobile.Pages.FournisseursPage"
             Title="Fournisseurs"
             BackgroundColor="#F5F7FA">

    <Grid RowDefinitions="Auto,*">

        <!-- Barre de recherche -->
        <Border Grid.Row="0"
                Margin="16,12,16,8"
                Padding="12,0"
                BackgroundColor="White"
                Stroke="#E2E8F0"
                StrokeThickness="1.5">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="Auto,*">
                <Label Grid.Column="0" Text="🔍" FontSize="14" VerticalOptions="Center" Margin="0,0,8,0" />
                <SearchBar Grid.Column="1"
                           x:Name="FournisseurSearchBar"
                           Placeholder="Rechercher un fournisseur..."
                           TextChanged="OnSearchTextChanged"
                           BackgroundColor="Transparent"
                           HeightRequest="44" />
            </Grid>
        </Border>

        <!-- Liste des fournisseurs -->
        <RefreshView Grid.Row="1"
                     x:Name="FournisseursRefreshView"
                     Refreshing="OnRefreshing"
                     RefreshColor="#2563EB">
            <CollectionView x:Name="FournisseursCollectionView"
                            Margin="16,0,16,16">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,6,0,6"
                                Padding="16"
                                BackgroundColor="White"
                                StrokeThickness="1"
                                Stroke="#E2E8F0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border Grid.Column="0"
                                            HeightRequest="44"
                                            WidthRequest="44"
                                            BackgroundColor="#EFF6FF"
                                            StrokeThickness="0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10" />
                                        </Border.StrokeShape>
                                        <Label Text="🏢" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                        <Label Text="{Binding Nom}"
                                               FontAttributes="Bold"
                                               FontSize="15"
                                               TextColor="#1E293B" />
                                        <Label Text="{Binding Adresse, TargetNullValue='Adresse non renseignée'}"
                                               FontSize="12"
                                               TextColor="#64748B"
                                               LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>

                                    <Border Grid.Column="2"
                                            BackgroundColor="#F0FDF4"
                                            Padding="8,4"
                                            StrokeThickness="0"
                                            VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8" />
                                        </Border.StrokeShape>
                                        <Label Text="Actif"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="#16A34A" />
                                    </Border>
                                </Grid>

                                <BoxView HeightRequest="1" Color="#F1F5F9" />

                                <Grid ColumnDefinitions="*,*">
                                    <HorizontalStackLayout Grid.Column="0" Spacing="6">
                                        <Label Text="📞" FontSize="12" VerticalOptions="Center" />
                                        <Label Text="{Binding Telephone, TargetNullValue='-'}"
                                               FontSize="12"
                                               TextColor="#64748B"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Grid.Column="1" Spacing="6" HorizontalOptions="End">
                                        <Label Text="✉️" FontSize="12" VerticalOptions="Center" />
                                        <Label Text="{Binding Email, TargetNullValue='-'}"
                                               FontSize="12"
                                               TextColor="#64748B"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         Margin="40"
                                         Spacing="10">
                        <Label Text="🏢" FontSize="44" HorizontalOptions="Center" />
                        <Label Text="Aucun fournisseur trouvé"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#1E293B"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
