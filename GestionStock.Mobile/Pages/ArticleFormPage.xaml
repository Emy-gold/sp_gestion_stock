<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GestionStock.Mobile.Pages.ArticleFormPage"
             Title="{Binding FormTitle}"
             BackgroundColor="#F5F7FA">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- En-tête avec dégradé bleu -->
            <Grid Padding="20,16">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#1E3A5F" Offset="0.0" />
                        <GradientStop Color="#2563EB" Offset="1.0" />
                    </LinearGradientBrush>
                </Grid.Background>
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0"
                           Text="Informations de l'article"
                           TextColor="#BFDBFE"
                           FontSize="14"
                           FontAttributes="Bold"
                           CharacterSpacing="1"
                           VerticalOptions="Center" />
                    <Button Grid.Column="1"
                            x:Name="DeleteButton"
                            Text="🗑️ Supprimer"
                            Clicked="OnDeleteClicked"
                            BackgroundColor="#EF4444"
                            TextColor="White"
                            FontSize="11"
                            FontAttributes="Bold"
                            CornerRadius="8"
                            HeightRequest="32"
                            Padding="10,0"
                            IsVisible="False" />
                </Grid>
            </Grid>

            <!-- Corps du formulaire -->
            <VerticalStackLayout Padding="20" Spacing="18">

                <!-- SECTION IMAGE -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="PHOTO DE L'ARTICLE"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="#64748B"
                           CharacterSpacing="1" />

                    <!-- Carte de prévisualisation Image -->
                    <Border BackgroundColor="White"
                            Stroke="#E2E8F0"
                            StrokeThickness="1.5"
                            Padding="12">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                            <!-- Aperçu Photo -->
                            <Border HeightRequest="140"
                                    WidthRequest="140"
                                    BackgroundColor="#F8FAFC"
                                    StrokeThickness="1"
                                    Stroke="#CBD5E1"
                                    HorizontalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Grid>
                                    <VerticalStackLayout x:Name="ImagePlaceholderContainer"
                                                         VerticalOptions="Center"
                                                         HorizontalOptions="Center"
                                                         Spacing="4">
                                        <Label Text="📷" FontSize="36" HorizontalOptions="Center" />
                                        <Label Text="Aucune photo" FontSize="11" TextColor="#94A3B8" HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                    <Image x:Name="ArticleImagePreview"
                                           Aspect="AspectFit"
                                           IsVisible="False" />
                                </Grid>
                            </Border>

                            <!-- Boutons d'action Image -->
                            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                                <Button Text="📁 Galerie"
                                        Clicked="OnPickPhotoClicked"
                                        BackgroundColor="#EFF6FF"
                                        TextColor="#2563EB"
                                        FontSize="12"
                                        FontAttributes="Bold"
                                        CornerRadius="8"
                                        HeightRequest="36"
                                        Padding="14,0" />

                                <Button Text="📸 Caméra"
                                        Clicked="OnTakePhotoClicked"
                                        BackgroundColor="#EFF6FF"
                                        TextColor="#2563EB"
                                        FontSize="12"
                                        FontAttributes="Bold"
                                        CornerRadius="8"
                                        HeightRequest="36"
                                        Padding="14,0" />

                                <Button x:Name="RemovePhotoButton"
                                        Text="✕ Retirer"
                                        Clicked="OnRemovePhotoClicked"
                                        BackgroundColor="#FEE2E2"
                                        TextColor="#EF4444"
                                        FontSize="12"
                                        FontAttributes="Bold"
                                        CornerRadius="8"
                                        HeightRequest="36"
                                        Padding="10,0"
                                        IsVisible="False" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Référence -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="RÉFÉRENCE *"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="#374151"
                           CharacterSpacing="1" />
                    <Border BackgroundColor="White"
                            Padding="14,0"
                            StrokeThickness="1.5"
                            Stroke="#E2E8F0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Entry x:Name="ReferenceEntry"
                               Placeholder="Ex: ART-001"
                               PlaceholderColor="#94A3B8"
                               TextColor="#1E293B"
                               BackgroundColor="Transparent"
                               HeightRequest="48" />
                    </Border>
                </VerticalStackLayout>

                <!-- Désignation -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="DÉSIGNATION *"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="#374151"
                           CharacterSpacing="1" />
                    <Border BackgroundColor="White"
                            Padding="14,0"
                            StrokeThickness="1.5"
                            Stroke="#E2E8F0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Entry x:Name="DesignationEntry"
                               Placeholder="Nom de l'article"
                               PlaceholderColor="#94A3B8"
                               TextColor="#1E293B"
                               BackgroundColor="Transparent"
                               HeightRequest="48" />
                    </Border>
                </VerticalStackLayout>

                <!-- Description -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="DESCRIPTION"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="#374151"
                           CharacterSpacing="1" />
                    <Border BackgroundColor="White"
                            Padding="14,8"
                            StrokeThickness="1.5"
                            Stroke="#E2E8F0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Editor x:Name="DescriptionEditor"
                                HeightRequest="80"
                                Placeholder="Description détaillée (optionnel)"
                                PlaceholderColor="#94A3B8"
                                TextColor="#1E293B"
                                BackgroundColor="Transparent" />
                    </Border>
                </VerticalStackLayout>

                <!-- Code-barres -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="CODE-BARRES"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="#374151"
                           CharacterSpacing="1" />
                    <Border BackgroundColor="White"
                            Padding="14,0"
                            StrokeThickness="1.5"
                            Stroke="#E2E8F0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Entry x:Name="CodeBarreEntry"
                               Placeholder="Ex: 376000000001"
                               PlaceholderColor="#94A3B8"
                               TextColor="#1E293B"
                               BackgroundColor="Transparent"
                               HeightRequest="48" />
                    </Border>
                </VerticalStackLayout>

                <!-- Catégorie -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="CATÉGORIE *"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="#374151"
                           CharacterSpacing="1" />
                    <Border BackgroundColor="White"
                            Padding="14,0"
                            StrokeThickness="1.5"
                            Stroke="#E2E8F0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Picker x:Name="CategoryPicker"
                                Title="Sélectionner une catégorie"
                                TitleColor="#94A3B8"
                                TextColor="#1E293B"
                                BackgroundColor="Transparent"
                                ItemDisplayBinding="{Binding Nom}"
                                HeightRequest="48" />
                    </Border>
                </VerticalStackLayout>

                <!-- Message d'erreur -->
                <Border x:Name="ErrorContainer"
                        BackgroundColor="#FEF2F2"
                        Padding="14,10"
                        StrokeThickness="1"
                        Stroke="#FECACA"
                        IsVisible="False">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <Label x:Name="ErrorLabel"
                           TextColor="#DC2626"
                           FontSize="13"
                           IsVisible="False" />
                </Border>

                <!-- Bouton Enregistrer -->
                <Button x:Name="SaveButton"
                        Text="💾  Enregistrer l'article"
                        Clicked="OnSaveClicked"
                        TextColor="White"
                        FontSize="15"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        HeightRequest="52"
                        Margin="0,6,0,0">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#2563EB" Offset="0.0" />
                            <GradientStop Color="#1D4ED8" Offset="1.0" />
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>

                <ActivityIndicator x:Name="SavingIndicator"
                                   IsRunning="False"
                                   IsVisible="False"
                                   Color="#2563EB"
                                   HeightRequest="30" />

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>