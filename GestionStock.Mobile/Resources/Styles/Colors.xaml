<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- === Palette Branded — GestionStock === -->
    <!-- Bleu marine profond — couleur principale -->
    <Color x:Key="Primary">#1A2B4A</Color>
    <Color x:Key="PrimaryDark">#2E4270</Color>
    <Color x:Key="PrimaryLight">#3A5FA0</Color>
    <Color x:Key="PrimaryDarkText">#E8EEF8</Color>

    <!-- Accent neutre — couleur d'accentuation douce -->
    <Color x:Key="Accent">#4A90C4</Color>
    <Color x:Key="AccentDark">#2563EB</Color>
    <Color x:Key="AccentLight">#BFDBFE</Color>

    <!-- Couleurs secondaires -->
    <Color x:Key="Secondary">#E8EEF8</Color>
    <Color x:Key="SecondaryDark">#B8C8E8</Color>
    <Color x:Key="SecondaryDarkText">#3A5FA0</Color>
    <Color x:Key="Tertiary">#0D1A30</Color>

    <!-- Succès / Erreur -->
    <Color x:Key="Success">#2ECC71</Color>
    <Color x:Key="Danger">#E74C3C</Color>
    <Color x:Key="Warning">#F39C12</Color>
    <Color x:Key="Info">#3498DB</Color>

    <!-- Neutres & Standard -->
    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="OffBlack">#0D1A30</Color>
    <Color x:Key="MidnightBlue">#0A1628</Color>
    <Color x:Key="Magenta">#D63384</Color>
    <Color x:Key="Yellow">#FDE047</Color>

    <!-- Gris -->
    <Color x:Key="Gray100">#F5F7FA</Color>
    <Color x:Key="Gray200">#E8ECF2</Color>
    <Color x:Key="Gray300">#C8D0DC</Color>
    <Color x:Key="Gray400">#9AAABB</Color>
    <Color x:Key="Gray500">#6B7F96</Color>
    <Color x:Key="Gray600">#3D5068</Color>
    <Color x:Key="Gray900">#1A2434</Color>
    <Color x:Key="Gray950">#0D1420</Color>

    <!-- Surface cards -->
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="SurfaceDark">#162235</Color>
    <Color x:Key="CardBorder">#E2E8F0</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>

</ResourceDictionary>