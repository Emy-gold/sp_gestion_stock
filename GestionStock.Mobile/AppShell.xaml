<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="GestionStock.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:GestionStock.Mobile.Pages"
    FlyoutBehavior="Flyout"
    Shell.BackgroundColor="#FFFFFF"
    Shell.ForegroundColor="#1E293B"
    Shell.TitleColor="#1E293B"
    FlyoutBackgroundColor="#FFFFFF">

    <!-- En-tête Barre Supérieure -->
    <Shell.TitleView>
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Padding="0,4,0,4">
            <Image Grid.Column="0"
                   Source="standard_profil_logo.png"
                   HeightRequest="28"
                   WidthRequest="28"
                   Aspect="AspectFit" />
            <Label Grid.Column="1"
                   Text="Standard Profil"
                   TextColor="#1E293B"
                   FontAttributes="Bold"
                   FontSize="17"
                   VerticalOptions="Center" />
        </Grid>
    </Shell.TitleView>

    <!-- En-tête du Menu Latéral (Flyout Header) -->
    <Shell.FlyoutHeader>
        <Grid Padding="20,44,20,24" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1E3A5F" Offset="0.0" />
                    <GradientStop Color="#2563EB" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>

            <HorizontalStackLayout Grid.Row="0" Spacing="12">
                <!-- Avatar utilisateur -->
                <Border HeightRequest="52"
                        WidthRequest="52"
                        BackgroundColor="#B1D3B9"
                        StrokeThickness="1"
                        Stroke="#B1D3B9">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="26" />
                    </Border.StrokeShape>
                    <Label x:Name="FlyoutAvatarInitial"
                           Text="SP"
                           TextColor="#FFFFFF"
                           FontSize="20"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                    <Label x:Name="FlyoutUserName"
                           Text="Admin"
                           TextColor="#FFFFFF"
                           FontSize="16"
                           FontAttributes="Bold" />
                    <Label x:Name="FlyoutUserEmail"
                           Text="admin@standardprofil.com"
                           TextColor="#BFDBFE"
                           FontSize="12" />
                </VerticalStackLayout>
            </HorizontalStackLayout>

            <!-- Badge Rôle -->
            <Border Grid.Row="1"
                    BackgroundColor="#B1D3B9"
                    Padding="10,4"
                    StrokeThickness="0"
                    HorizontalOptions="Start"
                    Margin="0,8,0,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Label x:Name="FlyoutUserRole"
                       Text="🛡️ Administrateur"
                       TextColor="#FFFFFF"
                       FontSize="11"
                       FontAttributes="Bold" />
            </Border>
        </Grid>
    </Shell.FlyoutHeader>

    <!-- Pied du Menu Latéral (Flyout Footer) -->
    <Shell.FlyoutFooter>
        <Grid BackgroundColor="#F8FAFC" Padding="16,14">
            <Border BackgroundColor="#FEF2F2"
                    StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <Button Text="🚪  Se déconnecter"
                        Clicked="OnLogoutClicked"
                        BackgroundColor="Transparent"
                        TextColor="#DC2626"
                        FontSize="13"
                        FontAttributes="Bold"
                        CornerRadius="10"
                        HeightRequest="44" />
            </Border>
        </Grid>
    </Shell.FlyoutFooter>

    <!-- Menu Items -->
    <FlyoutItem Title="Tableau de bord" Icon="dotnet_bot.png" Route="DashboardPage">
        <ShellContent ContentTemplate="{DataTemplate pages:DashboardPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Gestion des Articles" Icon="dotnet_bot.png" Route="ArticlesPage">
        <ShellContent ContentTemplate="{DataTemplate pages:ArticlesPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Gestion catégories" Icon="dotnet_bot.png" Route="CategoriesPage">
        <ShellContent ContentTemplate="{DataTemplate pages:CategoriesPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Mouvements de Stock" Icon="dotnet_bot.png" Route="OperationsPage">
        <ShellContent ContentTemplate="{DataTemplate pages:OperationsPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Catégories d'Opérations" Icon="dotnet_bot.png" Route="CategoryOperationsPage">
        <ShellContent ContentTemplate="{DataTemplate pages:CategoryOperationsPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Fournisseurs" Icon="dotnet_bot.png" Route="FournisseursPage">
        <ShellContent ContentTemplate="{DataTemplate pages:FournisseursPage}" />
    </FlyoutItem>

    <FlyoutItem Title="👥 Utilisateurs">
        <FlyoutItem.Icon>
            <FontImageSource FontFamily="OpenSansRegular" Glyph="👥" Color="#2563EB" />
        </FlyoutItem.Icon>
        <ShellContent ContentTemplate="{DataTemplate pages:UsersPage}" />
    </FlyoutItem>

    <FlyoutItem Title="🛡️ Rôles">
        <FlyoutItem.Icon>
            <FontImageSource FontFamily="OpenSansRegular" Glyph="🛡️" Color="#2563EB" />
        </FlyoutItem.Icon>
        <ShellContent ContentTemplate="{DataTemplate pages:RolesPage}" />
    </FlyoutItem>

</Shell>